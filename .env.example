# RepoLens AI — PLACEHOLDERS ONLY
# Copy to an ignored .env only when deliberately configuring local runtime.
# Replace every CHANGE_ME value; these examples are not operational credentials.
# Only keys defined in core/config.py are accepted here; unknown keys stop startup.
# The URL below matches docker-compose.yml (user repolens, loopback port 5435,
# database repolens_dev); use the password you put in .env.compose.
DATABASE_URL=postgresql+asyncpg://repolens:CHANGE_ME_LOCAL_DB_PASSWORD@127.0.0.1:5435/repolens_dev
# Inherited PathReview settings; not used by the current RepoLens workflows.
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=http://localhost:8001
LLM_PROVIDER=mock
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
# Optional server-side token; leave empty for anonymous public GitHub requests.
GITHUB_TOKEN=
APP_ENV=development
SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_LOCAL_SECRET
LOG_LEVEL=INFO

# Independent PostgreSQL worker (no Redis queue required)
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300

# Phase 1.7B: approved providers only; hosted calls are OFF by default.
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_LMSTUDIO_BASE_URL=http://localhost:1235/v1
# Docker uses http://host.docker.internal:1235/v1 (Compose default).
EMBEDDING_LMSTUDIO_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_LMSTUDIO_DIMENSIONS=768
EMBEDDING_LMSTUDIO_QUANTIZATION=Q4_K_M
EMBEDDING_LMSTUDIO_VERSION=nomic-v1.5-q4_k_m-v1
EMBEDDING_LMSTUDIO_API_KEY=
EMBEDDING_LMSTUDIO_MAX_REQUESTS=512
EMBEDDING_MISTRAL_BASE_URL=https://api.mistral.ai/v1
EMBEDDING_MISTRAL_MODEL=mistral-embed
EMBEDDING_MISTRAL_DIMENSIONS=1024
EMBEDDING_MISTRAL_VERSION=mistral-embed-2312-v1
EMBEDDING_MISTRAL_API_KEY=
EMBEDDING_HOSTED_SOURCE_ALLOWED=false
# Explicit server approval + secure key + positive request budget required.
EMBEDDING_MISTRAL_MAX_REQUESTS=0
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_INPUT_TOKENS=2048
EMBEDDING_MAX_BATCH_TOKENS=8192
EMBEDDING_MAX_CHUNKS=2000
EMBEDDING_MAX_INDEX_TOKENS=500000
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_RETRIES=2

# Phase 1.7C1: query transmission requires its OWN explicit hosted opt-in.
SEMANTIC_SEARCH_HOSTED_QUERY_ALLOWED=false
SEMANTIC_SEARCH_CONCURRENCY=2
SEMANTIC_SEARCH_TIMEOUT_SECONDS=45
SEMANTIC_SEARCH_MAX_PROVIDER_REQUESTS=3

# Overall hybrid request deadline, including embedding and bounded BM25 (maximum 120).
HYBRID_SEARCH_TIMEOUT_SECONDS=55

# Local-only Batch1 reasoning (never a hosted fallback)
GENERATION_BASE_URL=http://localhost:1235/v1
GENERATION_MODEL=qwen/qwen3.5-9b
GENERATION_TIMEOUT_SECONDS=90
GENERATION_MAX_INPUT_BYTES=4096
GENERATION_MAX_OUTPUT_TOKENS=512
GENERATION_MAX_RESPONSE_BYTES=65536
GENERATION_CONCURRENCY=1
GENERATION_TEMPERATURE=0
GENERATION_LOCAL_API_KEY=
QA_TIMEOUT_SECONDS=180

# Explicit protocol selection; never auto-fallback. Native disables reasoning and storage.
GENERATION_PROTOCOL=lmstudio-native


# Grounded Q&A: local stays default until all hosted acceptance gates are signed off.
QA_PROVIDER=lmstudio
QA_GEMINI_ENABLED=false
QA_GEMINI_PRIMARY_ACCEPTED=false
QA_GEMINI_LEDGER_PATH=.test-tmp/gemini-production-ledger.sqlite3
QA_GEMINI_BUDGET_STAGE=development
# Put GEMINI_API_KEY and GEMINI_MODEL=gemini-3.5-flash-lite in private
# process environment or ignored .env.gemini.local, never in client variables.

# Career processing remains explicit opt-in; hosted credentials belong in the private source above.
CAREER_J2_ENABLED=false
INVESTIGATION_ENABLED=false
DURABLE_INVESTIGATION_ENABLED=false
